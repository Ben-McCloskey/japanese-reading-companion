{
  "name": "japanese-reading-companion",
  "version": "0.1.1",
  "description": "A local desktop app for reading Japanese with furigana and an SRS deck built from your own reading.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && env -u ELECTRON_RUN_AS_NODE PYTHON_PATH=/opt/homebrew/bin/python3.12 electron-builder",
    "release": "npm run build && env -u ELECTRON_RUN_AS_NODE PYTHON_PATH=/opt/homebrew/bin/python3.12 electron-builder --publish always",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "db:reset": "tsx src/main/scripts/db-reset.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "electron-updater": "^6.8.3",
    "kuromoji": "^0.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sax": "^1.6.0",
    "ts-fsrs": "^5.3.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/sax": "^1.2.7",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "lucide-react": "^0.453.0",
    "postcss": "^8.4.47",
    "tailwind-merge": "^2.5.3",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
